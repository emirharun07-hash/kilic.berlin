{
  "name": "orthomitte-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "test": "npm run check && npm run build && node scripts/verify-build.mjs",
    "test:urls": "node scripts/check-urls.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "deploy:preview": "astro build && wrangler versions upload",
    "deploy:production": "npm run build:production && wrangler deploy",
    "golive:check": "node scripts/golive-check.mjs",
    "build:production": "node scripts/golive-check.mjs && astro build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^6.4.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "vite": "7.3.7"
  },
  "description": "Website der Orthopädischen Praxis Mitte, Berlin – Astro, statisch, gehostet auf Cloudflare Workers"
}
