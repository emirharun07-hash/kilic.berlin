---
/** Anamnesebogen (alte URL: /anamnese). Link zum externen Bogen: src/data/praxis.ts → anamnesebogen */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import { praxis } from '@/data/praxis';
import { breadcrumbSchema } from '@/data/strukturierte-daten';

const crumbs = [{ name: 'Startseite', href: '/' }, { name: 'Anamnesebogen', href: '/anamnese' }];
---

<BaseLayout
  title="Anamnesebogen online ausfüllen"
  description="Digitaler Anamnesebogen der Orthopädischen Praxis Mitte: Füllen Sie den Bogen vor Ihrem ersten Termin bequem online aus."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Anamnesebogen"
    eyebrow="Vor Ihrem Termin"
    intro="Der vorab von Ihnen ausgefüllte digitale Anamnesebogen erleichtert uns die Arbeit im Sprechzimmer. Wir haben u. a. mehr Zeit für die körperliche Untersuchung."
    crumbs={crumbs}
  >
    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
      <a href={praxis.anamnesebogen.url} target="_blank" rel="noopener noreferrer" class="btn-primary !px-7 !py-3.5">
        <Icon name="doc" class="size-5" /> Digitalen Anamnesebogen öffnen
        <span class="sr-only">(externer Anbieter {praxis.anamnesebogen.anbieter}, neues Fenster)</span>
      </a>
    </div>
  </PageHero>
  <section class="container-page py-16 sm:py-20">
    <div class="prose-praxis">
      <h2>Wann sollte ich den Bogen ausfüllen?</h2>
      <p>
        Sind Sie das erste Mal bei uns oder seit mehr als einem Jahr nicht mehr da gewesen, dann füllen Sie bitte den
        Anamnesebogen digital aus.
      </p>
      <h2>Hinweis zum Datenschutz</h2>
      <p>
        Der Anamnesebogen wird über den externen Dienst {praxis.anamnesebogen.anbieter} bereitgestellt. Mit dem Klick auf
        den Button verlassen Sie unsere Website. Informationen zur Verarbeitung Ihrer Daten finden Sie in unserer
        <a href="/datenschutz">Datenschutzerklärung</a>.
      </p>
    </div>
  </section>
</BaseLayout>
