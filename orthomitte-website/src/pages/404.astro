---
/** Fehlerseite für nicht gefundene Adressen. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { hauptmenue } from '@/data/navigation';
---

<BaseLayout title="Seite nicht gefunden" description="Die angeforderte Seite wurde nicht gefunden." noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-start justify-center py-24">
    <p class="eyebrow">Fehler 404</p>
    <h1 class="mt-4 text-5xl sm:text-6xl">Diese Seite gibt es leider nicht.</h1>
    <p class="mt-6 max-w-xl text-lg text-ink-600">
      Vielleicht wurde sie verschoben oder die Adresse enthält einen Tippfehler. Hier geht es weiter:
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary"><Icon name="arrow" class="size-4 rotate-180" /> Zur Startseite</a>
      {hauptmenue.map((m) => <a href={m.href} class="btn-secondary">{m.label}</a>)}
    </div>
  </section>
</BaseLayout>
