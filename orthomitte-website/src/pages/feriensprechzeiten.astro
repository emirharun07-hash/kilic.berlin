---
/** Feriensprechzeiten (alte URL: /feriensprechzeiten). Zeiten: src/data/oeffnungszeiten.ts → feriensprechzeiten */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import OpeningHours from '@/components/ui/OpeningHours.astro';
import BookingButton from '@/components/ui/BookingButton.astro';
import AkutterminInfo from '@/components/praxis/AkutterminInfo.astro';
import AnamneseHinweis from '@/components/praxis/AnamneseHinweis.astro';
import Icon from '@/components/ui/Icon.astro';
import { praxis } from '@/data/praxis';
import { breadcrumbSchema } from '@/data/strukturierte-daten';

const crumbs = [
  { name: 'Startseite', href: '/' },
  { name: 'Termine', href: '/termine' },
  { name: 'Feriensprechzeiten', href: '/feriensprechzeiten' },
];
---

<BaseLayout
  title="Sprechzeiten in den Ferien"
  description="Sprechzeiten der Orthopädischen Praxis Mitte in Berlin während der Schulferien, Hinweise zu Akutterminen und zur Online-Terminbuchung."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Sprechzeiten in den Ferien"
    eyebrow="Aktuelles aus der Praxis"
    intro="Während der Ferienzeit gelten geänderte Sprechzeiten. Bitte vereinbaren Sie einen Termin per Telefon, E-Mail oder über unseren Online-Terminkalender."
    crumbs={crumbs}
  />

  <section class="container-page grid grid-cols-1 gap-6 py-16 sm:py-20 lg:grid-cols-[1fr_1.1fr]">
    <div class="card p-7 sm:p-8">
      <h2 class="flex items-center gap-3 text-2xl"><Icon name="clock" class="size-6 text-brand-600" /> Feriensprechzeiten</h2>
      <OpeningHours class="mt-5" ferien hinweis={false} />
      <a href="/termine" class="link mt-5 inline-block text-sm">Reguläre Sprechzeiten</a>
    </div>
    <div class="card flex flex-col p-7 sm:p-8">
      <h2 class="flex items-center gap-3 text-2xl"><Icon name="calendar" class="size-6 text-brand-600" /> Terminvergabe</h2>
      <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-600">
        Bitte vereinbaren Sie einen Termin per Telefon, Mailanfrage oder über unseren Online-Terminkalender!
        Die Akuttermine werden nur <a href={`tel:${praxis.telefon.link}`} class="link">telefonisch</a> am selben Tag zu
        Beginn der normalen Sprechstunde vergeben.
      </p>
      <div class="mt-auto pt-8"><BookingButton /></div>
    </div>
  </section>
  <section class="container-page pb-10" aria-label="Akuttermine"><AkutterminInfo /></section>
  <section class="container-page pb-24"><AnamneseHinweis /></section>
</BaseLayout>
