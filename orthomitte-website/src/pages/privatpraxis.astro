---
/**
 * Privatpraxis für Funktionelle Medizin (alte URL: /privatpraxis).
 * Texte von der bisherigen Website; Leistungen aus src/content/leistungen (bereich: funktionelle-medizin).
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TeamCard from '@/components/team/TeamCard.astro';
import LeistungKarte from '@/components/leistungen/LeistungKarte.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import empfang from '@/assets/images/praxis/privatpraxis-empfang.jpg';
import { breadcrumbSchema } from '@/data/strukturierte-daten';

const crumbs = [{ name: 'Startseite', href: '/' }, { name: 'Privatpraxis', href: '/privatpraxis' }];
const teamIds = ['arne-schlichting', 'buelent-kilic', 'christiane-baldini', 'isabelle-landenberger', 'frederik-giesker'];
const team = (await getCollection('team')).filter((p) => teamIds.includes(p.id)).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const leistungen = (await getCollection('leistungen'))
  .filter((l) => l.data.bereich === 'funktionelle-medizin' && l.data.inUebersicht)
  .sort((a, b) => (a.data.kategorie === b.data.kategorie ? a.data.reihenfolge - b.data.reihenfolge : a.data.kategorie.localeCompare(b.data.kategorie)));

const schwerpunkte = [
  'Orthopädie und Manuelle Medizin',
  'Osteopathie',
  'Funktionelle Medizin und Mikronährstofftherapie',
  'Klassische Akupunktur und Ohrakupunktur',
  'Stoßwellentherapie und Faszientherapie nach dem FDM-Konzept',
  'Individuell abgestimmte Infusionstherapien',
  'Diagnostik und Behandlung chronischer und degenerativer Erkrankungen',
  'Hormon- und Stoffwechseldiagnostik sowie individuelle Hormontherapie',
  'Darmgesundheit, Mikrobiomdiagnostik und Darmsymbiosetherapie',
  'Stressmedizin und Psychotherapie',
  'Umweltmedizin und klinische Metalltoxikologie',
];
---

<BaseLayout
  title="Privatpraxis für Funktionelle Medizin"
  description="Privatpraxis für Funktionelle Medizin in Berlin-Mitte: Osteopathie, Mikronährstoff- und Infusionstherapie, Hormon- und Stressmedizin für Privatpatienten."
  image={empfang}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Ganzheitliche Medizin unter einem Dach"
    eyebrow="Unsere Privatpraxis"
    intro="Ergänzend zu unserer orthopädischen Praxis bieten wir Ihnen in unserer eigenständigen Privatpraxis, die sich im selben Gebäude und auf derselben Etage befindet, ein vielseitiges medizinisches und therapeutisches Leistungsspektrum an."
    crumbs={crumbs}
    image={empfang}
    imageAlt="Heller Empfangsbereich der Privatpraxis mit weißem Tresen"
  >
    <p class="mt-6 inline-flex items-center gap-2 rounded-full bg-sage-100 px-4 py-2 text-sm font-medium text-sage-700">
      <Icon name="info" class="size-4" /> Für privatversicherte Patientinnen und Patienten sowie Selbstzahler
    </p>
  </PageHero>

  <section class="container-page grid grid-cols-1 gap-12 py-20 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
    <div class="prose-praxis">
      <p>
        Unser Ziel ist es, bewährte schulmedizinische Verfahren mit ergänzenden ganzheitlichen und funktionellen
        Behandlungskonzepten zu verbinden. Dabei legen wir besonderen Wert auf eine individuelle Betreuung, eine sorgfältige
        Diagnostik und die Berücksichtigung möglicher Ursachen und Zusammenhänge gesundheitlicher Beschwerden.
      </p>
      <h2>Der Mensch im Mittelpunkt</h2>
      <p>
        Gesundheit ist mehr als die Abwesenheit einzelner Beschwerden. Deshalb betrachten wir unsere Patientinnen und
        Patienten möglichst umfassend und berücksichtigen neben körperlichen Symptomen auch individuelle Lebensumstände,
        Belastungen und mögliche Wechselwirkungen verschiedener Organsysteme.
      </p>
      <p>
        Wir nehmen uns Zeit für Sie – für eine ausführliche Anamnese, eine sorgfältige Diagnostik und die gemeinsame
        Entwicklung eines auf Ihre Bedürfnisse abgestimmten Behandlungskonzepts.
      </p>
      <p><strong>Wir freuen uns, Sie in unserer Privatpraxis begrüßen zu dürfen!</strong></p>
    </div>
    <div class="card self-start p-7 sm:p-8" data-reveal>
      <h2 class="text-2xl">Unsere medizinischen und therapeutischen Schwerpunkte</h2>
      <ul class="mt-6 space-y-3">
        {
          schwerpunkte.map((s) => (
            <li class="flex gap-3 text-[0.9375rem] leading-snug text-ink-700">
              <Icon name="chevron" class="mt-0.5 size-4 shrink-0 text-brand-600" />
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24" aria-labelledby="pp-team">
    <div class="container-page">
      <SectionHeading eyebrow="Ein erfahrenes Team" title="Unterschiedliche medizinische Schwerpunkte" id="pp-team">
        <p>
          Neben Herrn Schlichting und Herrn Dr. Kılıç sind auch Frau Dr. Baldini, Fachärztin für Innere Medizin, sowie
          Frau dr. Landenberger in unserer Privatpraxis tätig. Herr Frederik Giesker ergänzt als fest angestellter
          Osteopath unser Team.
        </p>
      </SectionHeading>
      <ul class="mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
        {team.map((p) => <li data-reveal><TeamCard person={p} /></li>)}
      </ul>
      <div class="prose-praxis mt-14 grid max-w-none grid-cols-1 gap-x-12 lg:grid-cols-3 [&>*]:max-w-none">
        <p class="!mt-0">
          <strong>Frau Dr. Baldini</strong> verfügt über langjährige klinische Erfahrung in der Inneren Medizin, unter anderem als
          Fach- und Oberärztin auf einer interdisziplinären Intensivstation. Ihre zusätzlichen Qualifikationen und Fortbildungen
          umfassen insbesondere die funktionelle Medizin, Stressmedizin, Immunologie, mitochondriale Medizin und
          Mikronährstofftherapie. Weitere Schwerpunkte ihrer Arbeit sind die Darmgesundheit, das intestinale Mikrobiom,
          hormonelle Regulationsstörungen sowie die Diagnostik und Behandlung chronischer Erkrankungen. Durch ihre
          psychotherapeutische Zusatzqualifikation berücksichtigt sie auch das Zusammenspiel körperlicher und psychischer Faktoren.
        </p>
        <p class="!mt-0">
          <strong>Frau dr. Landenberger</strong> bringt vielfältige Erfahrungen aus unterschiedlichen Bereichen der ambulanten und
          klinischen Medizin mit. Ihre besonderen Fortbildungsschwerpunkte liegen in der funktionellen Medizin, der klinischen
          Metalltoxikologie, der Chelattherapie sowie der individuellen Hormontherapie.
        </p>
        <p class="!mt-0">
          <strong>Herr Frederik Giesker</strong> ergänzt als fest angestellter Osteopath unser Team. Er bietet in unseren
          Praxisräumlichkeiten osteopathische Behandlungen an und erweitert damit unser therapeutisches Angebot insbesondere im
          Bereich funktioneller Beschwerden des Bewegungsapparates. Durch die Zusammenarbeit der verschiedenen medizinischen und
          therapeutischen Fachrichtungen können wir unseren Patientinnen und Patienten eine umfassende, individuell abgestimmte
          Betreuung anbieten.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-20 sm:py-24" aria-labelledby="pp-leistungen">
    <SectionHeading eyebrow="Leistungen" title="Leistungen der Privatpraxis" id="pp-leistungen" />
    <ul class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {leistungen.map((l) => <li data-reveal><LeistungKarte leistung={l} /></li>)}
    </ul>
    <p class="mt-10 text-[0.9375rem] text-ink-600">
      Folgen Sie uns auch auf
      <a href="https://www.instagram.com/orthomitte/" target="_blank" rel="noopener noreferrer" class="link">Instagram</a>!
    </p>
  </section>

  <CtaBand />
</BaseLayout>
