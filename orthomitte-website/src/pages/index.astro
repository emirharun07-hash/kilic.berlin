---
/**
 * Startseite. Inhalte: src/data/startseite.ts, leistungsbereiche.ts, Team aus src/content/team/.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookingButton from '@/components/ui/BookingButton.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import OpeningHours from '@/components/ui/OpeningHours.astro';
import MapEmbed from '@/components/ui/MapEmbed.astro';
import TeamCard from '@/components/team/TeamCard.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import TransitInfo from '@/components/ui/TransitInfo.astro';
import { hero, kennzahlen, privatpraxisHinweis, ueberUns, saeulen, praxisBilder, leistungsTeaser } from '@/data/startseite';
import { leistungsbereiche } from '@/data/leistungsbereiche';
import { praxis } from '@/data/praxis';

const team = (await getCollection('team'))
  .filter((p) => p.data.zeigeAufStartseite)
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-sand-100">
    <div aria-hidden="true" class="absolute -top-40 -left-40 size-[36rem] rounded-full border border-brand-200/50"></div>
    <div aria-hidden="true" class="absolute -top-16 -left-16 size-[22rem] rounded-full border border-brand-200/50"></div>
    <div class="container-page relative grid grid-cols-1 items-center gap-12 pt-12 pb-16 sm:pt-16 lg:grid-cols-[1.02fr_1fr] lg:gap-16 lg:pt-20 lg:pb-24">
      <div class="animate-fade-up">
        <p class="eyebrow">{hero.dachzeile}</p>
        <h1 class="mt-6 text-[2.75rem] leading-[1.02] sm:text-6xl lg:text-[4.5rem]">
          Ihr Spezialist für <em class="text-brand-600 not-italic">Orthopädie</em> in Berlin
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-600 sm:text-xl">{hero.text}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <BookingButton class="!px-7 !py-3.5" />
          <a href={hero.zweiterButton.href} class="btn-secondary !px-7 !py-3.5">
            {hero.zweiterButton.label}
            <Icon name="arrow" class="size-4" />
          </a>
        </div>
        <dl class="mt-12 grid max-w-lg grid-cols-3 divide-x divide-ink-200/80 border-t border-ink-200/80 pt-7">
          {
            kennzahlen.map((k, i) => (
              <div class:list={['flex flex-col-reverse', i > 0 && 'pl-5 sm:pl-7']}>
                <dt class="mt-1 text-[0.8125rem] text-ink-500">{k.label}</dt>
                <dd class="font-serif text-4xl text-ink-900 sm:text-[2.75rem]">{k.wert}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="animate-fade-up relative [animation-delay:150ms]">
        <div class="relative overflow-hidden rounded-[2rem] shadow-[var(--shadow-lift)]">
          <Image
            src={hero.bild}
            alt={hero.bildAlt}
            widths={[560, 800, 1100, 1400]}
            sizes="(min-width: 1024px) 48vw, 100vw"
            class="aspect-[4/4.2] w-full object-cover object-center sm:aspect-[4/3.4] lg:aspect-[4/4.4]"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/35 via-transparent to-transparent"></div>
        </div>
        <!-- schwebende Infokarte -->
        <div class="card absolute -bottom-6 left-4 flex max-w-[19rem] items-start gap-4 p-5 sm:-left-8 sm:p-6">
          <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600">
            <Icon name="pin" class="size-5" />
          </span>
          <div>
            <p class="text-[0.9375rem] font-semibold text-ink-900">Mitten in Berlin</p>
            <p class="mt-1 text-sm leading-snug text-ink-600">
              {praxis.adresse.strasse} · wenige Gehminuten vom Bahnhof Friedrichstraße
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PRIVATPRAXIS-HINWEIS ============ -->
  <section class="border-y border-ink-100 bg-white">
    <a
      href={privatpraxisHinweis.href}
      class="group container-page flex flex-col items-start justify-between gap-3 py-6 sm:flex-row sm:items-center"
    >
      <p class="flex items-center gap-3 text-[0.9375rem] text-ink-800 sm:text-base">
        <span class="rounded-full bg-sage-100 px-3 py-1 text-xs font-semibold tracking-wide text-sage-700 uppercase">Neu</span>
        {privatpraxisHinweis.text.replace(/^Neu:\s*/, '')}
      </p>
      <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
        {privatpraxisHinweis.linkLabel}
        <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
      </span>
    </a>
  </section>

  <!-- ============ WAS UNS AUSMACHT ============ -->
  <section class="container-page py-24 sm:py-32" aria-labelledby="ausmacht">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.25fr_1fr] lg:items-end lg:gap-20">
      <SectionHeading eyebrow={ueberUns.dachzeile} title={ueberUns.titel} id="ausmacht">
        <p>{ueberUns.text}</p>
      </SectionHeading>
      <div class="rounded-[var(--radius-card)] bg-brand-600 p-8 text-white shadow-[var(--shadow-lift)]" data-reveal>
        <Icon name="calendar" class="size-7 text-brand-100" />
        <p class="mt-5 font-serif text-2xl leading-snug">{ueberUns.terminHinweis.titel}</p>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-brand-50/90">{ueberUns.terminHinweis.text}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={praxis.terminbuchung.url}
            target="_blank"
            rel="noopener noreferrer"
            class="btn bg-white text-brand-700 hover:bg-brand-50"
            data-booking-link
          >
            Jetzt online buchen <span class="sr-only">(öffnet Doctolib in neuem Fenster)</span>
          </a>
          <a href="#kontakt" class="btn border border-white/40 text-white hover:bg-white/10">Sprechzeiten</a>
        </div>
      </div>
    </div>

    <ul class="mt-20 grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
      {
        saeulen.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="flex size-14 items-center justify-center rounded-2xl bg-white text-brand-600 shadow-[var(--shadow-soft)] ring-1 ring-ink-100">
              <Icon name={s.icon} class="size-6.5" />
            </span>
            <h3 class="mt-6 text-xl">{s.titel}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-600">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ PRAXIS-EINBLICKE ============ -->
  <section class="bg-white py-24 sm:py-28" aria-labelledby="einblicke">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading eyebrow="Unsere Räume" title="Einblicke in die Praxis" id="einblicke" />
        <a href="/überuns" class="link shrink-0 text-sm" data-reveal>Mehr über unsere Praxis</a>
      </div>
      <div class="mt-12 grid auto-rows-[12rem] grid-cols-2 gap-3 sm:auto-rows-[15rem] sm:gap-4 lg:grid-cols-4 lg:auto-rows-[17rem]">
        {
          praxisBilder.map((p, i) => (
            <figure
              class:list={[
                'group relative overflow-hidden rounded-2xl',
                i === 0 && 'col-span-2 row-span-2',
                i === 3 && 'col-span-2',
              ]}
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              <Image
                src={p.bild}
                alt={p.alt}
                widths={[400, 700, 1000, 1400]}
                sizes={i === 0 || i === 3 ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw'}
                class="size-full object-cover transition duration-700 ease-out group-hover:scale-[1.03]"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LEISTUNGEN ============ -->
  <section class="container-page py-24 sm:py-32" aria-labelledby="leistungen-heading">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <SectionHeading eyebrow={leistungsTeaser.dachzeile} title={leistungsTeaser.titel} id="leistungen-heading">
          <p>
            Von der manualmedizinischen Diagnostik bis zu speziellen Behandlungsmethoden – wir verbinden klassische Orthopädie
            mit funktionellen und ganzheitlichen Verfahren.
          </p>
        </SectionHeading>
        <div class="mt-10 hidden overflow-hidden rounded-[1.75rem] lg:block" data-reveal>
          <Image
            src={leistungsTeaser.bild}
            alt={leistungsTeaser.bildAlt}
            widths={[500, 800, 1100]}
            sizes="40vw"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal>
          <a href="/leistungen" class="btn-primary">Alle Leistungen <Icon name="arrow" class="size-4" /></a>
          <a href="/privatpraxis" class="btn-secondary">Privatpraxis</a>
        </div>
      </div>
      <ol class="space-y-4">
        {
          leistungsbereiche.map((b, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <a
                href={`/leistungen#${b.id}`}
                class="group card flex gap-6 p-7 transition duration-300 hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift)] sm:p-8"
              >
                <span class="font-serif text-sm text-brand-600 tabular-nums">0{i + 1}</span>
                <div class="min-w-0 flex-1">
                  <h3 class="flex items-center justify-between gap-4 text-2xl">
                    {b.titel}
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full border border-ink-200 text-ink-700 transition group-hover:border-brand-600 group-hover:bg-brand-600 group-hover:text-white">
                      <Icon name="arrow" class="size-4" />
                    </span>
                  </h3>
                  <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-600">{b.text}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ TEAM ============ -->
  <section class="relative overflow-hidden bg-ink-900 py-24 sm:py-32" aria-labelledby="team-heading">
    <div aria-hidden="true" class="absolute -right-48 -bottom-48 size-[40rem] rounded-full border border-white/5"></div>
    <div class="container-page relative">
      <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
        <SectionHeading eyebrow="Unser Team" title="Erfahrung, die Sie spüren" id="team-heading" light>
          <p>Fachärztinnen und Fachärzte, Therapeuten und ein engagiertes Praxisteam – persönlich für Sie da.</p>
        </SectionHeading>
        <a href="/überuns" class="btn-ghost-light shrink-0" data-reveal>
          Das ganze Team kennenlernen <Icon name="arrow" class="size-4" />
        </a>
      </div>
      <ul class="mt-14 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 lg:grid-cols-6">
        {
          team.map((p, i) => (
            <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <TeamCard person={p} variant="dark" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ KONTAKT ============ -->
  <section id="kontakt" class="container-page py-24 sm:py-32" aria-labelledby="kontakt-heading">
    <SectionHeading eyebrow="Kontakt" title="So erreichen Sie uns" id="kontakt-heading" />
    <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <div class="card p-7 sm:p-8 lg:col-span-4" data-reveal>
        <h3 class="flex items-center gap-3 text-xl"><Icon name="clock" class="size-5 text-brand-600" /> Sprechzeiten</h3>
        <OpeningHours class="mt-5" />
        <BookingButton class="mt-6 w-full" />
      </div>
      <div class="card flex flex-col gap-7 p-7 sm:p-8 lg:col-span-3" data-reveal style="--reveal-delay:80ms">
        <div>
          <h3 class="flex items-center gap-3 text-xl"><Icon name="phone" class="size-5 text-brand-600" /> Kontakt</h3>
          <ul class="mt-5 space-y-3 text-[0.9375rem]">
            <li><span class="text-ink-500">Telefon</span><br /><a href={`tel:${praxis.telefon.link}`} class="link">{praxis.telefon.anzeige}</a></li>
            <li><span class="text-ink-500">Fax</span><br /><span class="text-ink-800">{praxis.fax}</span></li>
            <li><span class="text-ink-500">E-Mail</span><br /><a href={`mailto:${praxis.email}`} class="link">{praxis.email}</a></li>
          </ul>
        </div>
        <div>
          <h3 class="flex items-center gap-3 text-xl"><Icon name="pin" class="size-5 text-brand-600" /> Adresse</h3>
          <address class="mt-4 text-[0.9375rem] leading-relaxed text-ink-800 not-italic">
            {praxis.name}<br />{praxis.adresse.strasse} ({praxis.adresse.zusatz})<br />{praxis.adresse.plz} {praxis.adresse.ort}
          </address>
        </div>
      </div>
      <div class="flex flex-col gap-6 lg:col-span-5" data-reveal style="--reveal-delay:160ms">
        <MapEmbed />
        <TransitInfo />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
