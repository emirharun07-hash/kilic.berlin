---
/**
 * Informationsseite – Übersicht der Patienteninformationen (alte URL: /infoseite).
 * Neue Info-Seite aufnehmen: Datei in src/content/seiten/ anlegen und hier in `artikel` eintragen (Reihenfolge = Anzeige).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Icon from '@/components/ui/Icon.astro';
import { breadcrumbSchema } from '@/data/strukturierte-daten';

/** Dateinamen (ohne .md) aus src/content/seiten/ in Anzeigereihenfolge */
const artikel = [
  'fuss-laufstil-schuhwerk',
  'vegetatives-nervensystem',
  'fussfehlstellungen',
  'antientzuendliche-praeparate',
  'kurzer-fuss-nach-janda',
  'rueckenschmerzen',
  'funktionsstoerungen',
  'mitochondrien',
  'hypermobilitaet',
  'oxidativer-stress',
  'silent-inflammation',
  'antientzuendliche-lebensweise',
  'vitamin-d-info',
  'labor-entzuendungen',
  'impfungen',
];
const seiten = await getCollection('seiten');
const liste = artikel.map((id) => {
  const s = seiten.find((x) => x.id === id);
  if (!s) throw new Error(`Info-Seite "${id}" nicht gefunden (src/pages/infoseite.astro)`);
  return s;
});
const crumbs = [{ name: 'Startseite', href: '/' }, { name: 'Informationsseite', href: '/infoseite' }];
---

<BaseLayout
  title="Patienteninformationen – Medizinische Hintergründe erklärt"
  description="Verständliche medizinische Informationen zu Ursachen, Symptomen und Therapien aus Orthopädie und Funktioneller Medizin – von Rückenschmerzen bis Vitamin D."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Medizinische Hintergründe erklärt"
    eyebrow="Informationsseite"
    intro="Hier finden Sie verständliche medizinische Informationen zu Ursachen, Symptomen und Therapien aus Orthopädie und Funktioneller Medizin."
    crumbs={crumbs}
  />
  <section class="container-page py-16 sm:py-20" aria-label="Artikel">
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        liste.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <a href={`/${s.data.url}`} class="group card flex h-full flex-col p-7 transition duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-lift)]">
              <span class="font-serif text-sm text-brand-600 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="mt-3 text-xl leading-snug group-hover:text-brand-700">{s.data.titel}</h2>
              {s.data.einleitung && <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">{s.data.einleitung}</p>}
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
                Weiterlesen <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <CtaBand />
</BaseLayout>
