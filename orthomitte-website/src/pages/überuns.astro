---
/**
 * Über uns / Unser Team  (alte URL: /überuns)
 * Personen: src/content/team/*.md · Praxisteam: src/data/praxisteam.ts
 */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TeamGrid from '@/components/team/TeamGrid.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { praxisteam } from '@/data/praxisteam';
import { praxisBilder } from '@/data/startseite';
import { breadcrumbSchema } from '@/data/strukturierte-daten';

const crumbs = [
  { name: 'Startseite', href: '/' },
  { name: 'Über uns', href: '/überuns' },
];
---

<BaseLayout
  title="Über uns – Unser Team"
  description="Das Team der Orthopädischen Praxis Mitte in Berlin: Fachärzte für Orthopädie und Unfallchirurgie, ärztliches Team, Osteopath und Praxisteam."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Unser Team"
    eyebrow="Erfahren, engagiert, ganzheitlich"
    intro="Was unsere Praxis besonders macht, ist das Team, das dahintersteht. Zwei erfahrene Fachärzte für Orthopädie und Unfallchirurgie bilden den Kern unserer medizinischen Versorgung – ergänzt durch engagierte ärztliche Assistent:innen, die sich in der Weiterbildung zur Fachärztin bzw. zum Facharzt befinden, Arzthelferinnen (MFA), Auszubildende zur MFA sowie zuverlässige studentische Aushilfskräfte."
    crumbs={crumbs}
  />

  <section class="container-page py-20 sm:py-24" aria-labelledby="aerzte-heading">
    <SectionHeading eyebrow="Medizin & Therapie" title="Ärztinnen, Ärzte und Therapeuten" id="aerzte-heading">
      <p>Lernen Sie uns hier näher kennen – als Ärzt:innen, Menschen und als Team, das mit Überzeugung und Haltung für Ihre Gesundheit da ist.</p>
    </SectionHeading>
    <div class="mt-14">
      <TeamGrid />
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24" aria-labelledby="praxisteam-heading">
    <div class="container-page">
      <SectionHeading eyebrow="Für Sie da" title="Unser Praxisteam" id="praxisteam-heading" />
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          praxisteam.map((g, i) => (
            <div class="rounded-[var(--radius-card)] border border-ink-100 bg-sand-50 p-7" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <h3 class="text-xl">{g.gruppe}</h3>
              <ul class="mt-5 flex flex-wrap gap-2">
                {g.namen.map((n) => (
                  <li class="rounded-full bg-white px-4 py-2 text-[0.9375rem] text-ink-800 ring-1 ring-ink-100">{n}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page py-20 sm:py-24" aria-labelledby="raeume-heading">
    <SectionHeading eyebrow="Unsere Räume" title="Ihre Praxis in Berlin-Mitte" id="raeume-heading">
      <p>Unsere Praxis liegt im 2. Obergeschoss der Dorotheenstraße 56 – zentral und gut erreichbar, nur wenige Gehminuten vom Bahnhof Friedrichstraße.</p>
    </SectionHeading>
    <div class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        praxisBilder.map((p, i) => (
          <figure class="overflow-hidden rounded-2xl" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <Image src={p.bild} alt={p.alt} widths={[360, 600, 900]} sizes="(min-width: 1024px) 25vw, 50vw" class="aspect-[4/3] w-full object-cover" />
          </figure>
        ))
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>
