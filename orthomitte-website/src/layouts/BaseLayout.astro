---
/**
 * Grundlayout für JEDE Seite: <head>, Kopfzeile, Inhalt, Fußzeile.
 * Seiten übergeben nur Titel, Beschreibung und ggf. strukturierte Daten.
 */
import '@/styles/global.css';
import SeoHead from '@/components/seo/SeoHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileBookingBar from '@/components/layout/MobileBookingBar.astro';
import { praxisSchema } from '@/data/strukturierte-daten';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const { schema = [], ...seo } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fcfaf7" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SeoHead {...seo} schema={[praxisSchema(), ...schema]} />
  </head>
  <body class="flex min-h-dvh flex-col pb-[4.75rem] sm:pb-0">
    <Header />
    <main id="inhalt" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileBookingBar />
    <script>
      import '@/scripts/reveal';
    </script>
  </body>
</html>
