---
/** Karte einer Person (Foto, Name, Rolle). Verlinkt auf die Profilseite, falls vorhanden. */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { logoPath, logoViewBox } from '@/components/ui/logo-path';

interface Props {
  person: CollectionEntry<'team'>;
  variant?: 'light' | 'dark';
}
const { person, variant = 'light' } = Astro.props;
const { name, rolle, foto, fotoAlt, url } = person.data;
const Tag = url ? 'a' : 'div';
const dark = variant === 'dark';
---

<Tag href={url ? `/${url}` : undefined} class="group block">
  <div class:list={['relative aspect-[4/5] overflow-hidden rounded-2xl', dark ? 'bg-ink-800' : 'bg-sand-200']}>
    {
      foto ? (
        <Image
          src={foto}
          alt={fotoAlt ?? `Porträt von ${name}`}
          widths={[240, 360, 480, 640]}
          sizes="(min-width: 1024px) 16vw, (min-width: 768px) 30vw, 45vw"
          class="size-full object-cover object-top transition duration-700 ease-out group-hover:scale-[1.04]"
        />
      ) : (
        <div class="flex size-full items-center justify-center">
          <svg viewBox={logoViewBox} class:list={['size-1/3', dark ? 'text-ink-700' : 'text-sand-300']} aria-hidden="true">
            <path fill="currentColor" fill-rule="evenodd" d={logoPath} />
          </svg>
        </div>
      )
    }
  </div>
  <p class:list={['mt-4 font-serif text-lg leading-tight', dark ? 'text-white' : 'text-ink-900', url && 'group-hover:text-brand-600']}>
    {name}
  </p>
  <p class:list={['mt-1.5 text-[0.8125rem] leading-snug', dark ? 'text-ink-300' : 'text-ink-500']}>{rolle}</p>
</Tag>
