---
/**
 * Vorlage für eine Leistungsseite (src/content/leistungen/*.md).
 * Aufbau: Seitenkopf → Fließtext + Seitenleiste (Termin, verwandte Leistungen) → Abschluss-Band.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import BookingButton from '@/components/ui/BookingButton.astro';
import Icon from '@/components/ui/Icon.astro';
import MedizinischerHinweis from '@/components/ui/MedizinischerHinweis.astro';
import { praxis } from '@/data/praxis';
import { breadcrumbSchema } from '@/data/strukturierte-daten';

interface Props {
  entry: CollectionEntry<'leistungen'>;
}
const { entry } = Astro.props;
const d = entry.data;

const bereich =
  d.bereich === 'funktionelle-medizin'
    ? { name: 'Privatpraxis Funktionelle Medizin', href: '/privatpraxis', uebersicht: '/leistungen#privatpraxis-leistungen' }
    : { name: 'Leistungen', href: '/leistungen', uebersicht: '/leistungen' };

const crumbs = [
  { name: 'Startseite', href: '/' },
  { name: bereich.name, href: bereich.href },
  { name: d.titel, href: `/${d.url}` },
];

const verwandte = (await getCollection('leistungen'))
  .filter((l) => l.id !== entry.id && l.data.bereich === d.bereich && l.data.inUebersicht)
  .sort((a, b) => Number(b.data.kategorie === d.kategorie) - Number(a.data.kategorie === d.kategorie) || a.data.reihenfolge - b.data.reihenfolge)
  .slice(0, 6);
---

<BaseLayout
  title={d.seo.title ?? `${d.titel} in Berlin-Mitte`}
  description={d.seo.description ?? d.kurzbeschreibung}
  image={d.bild}
  noindex={d.seo.noindex}
  schema={[
    breadcrumbSchema(crumbs),
    {
      '@context': 'https://schema.org',
      '@type': 'MedicalWebPage',
      name: d.titel,
      about: { '@type': 'MedicalProcedure', name: d.titel },
      provider: { '@id': 'https://www.orthomitte.de/#praxis' },
      inLanguage: 'de',
    },
  ]}
>
  <PageHero
    title={d.titel}
    eyebrow={bereich.name}
    intro={d.kurzbeschreibung}
    crumbs={crumbs}
    image={d.bild}
    imageAlt={d.bildAlt ?? ''}
  />

  <div class="container-page grid grid-cols-1 gap-14 py-16 sm:py-20 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-20">
    <div class="min-w-0">
      <article class="prose-praxis">
        {d.autor && <p class="text-sm text-ink-500">{d.autor}</p>}
        <slot />
      </article>
      <MedizinischerHinweis komplementaer={d.komplementaer} />
    </div>

    <aside class="space-y-6 lg:sticky lg:top-32 lg:self-start" aria-label="Termin und weitere Leistungen">
      <div class="card p-7">
        <p class="font-serif text-2xl leading-snug text-ink-900">Termin vereinbaren</p>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-600">
          Buchen Sie Ihren Termin bequem online oder rufen Sie uns an.
        </p>
        <BookingButton class="mt-6 w-full" />
        <a href={`tel:${praxis.telefon.link}`} class="btn-secondary mt-3 w-full">
          <Icon name="phone" class="size-4.5" />{praxis.telefon.anzeige}
        </a>
      </div>

      {
        verwandte.length > 0 && (
          <nav class="card p-7" aria-labelledby="weitere-leistungen">
            <p id="weitere-leistungen" class="text-xs font-semibold tracking-[0.18em] text-ink-500 uppercase">
              Weitere Leistungen
            </p>
            <ul class="mt-4 divide-y divide-ink-100">
              {verwandte.map((l) => (
                <li>
                  <a href={`/${l.data.url}`} class="group flex items-center justify-between gap-3 py-3 text-[0.9375rem] text-ink-800 hover:text-brand-700">
                    {l.data.titel}
                    <Icon name="chevron" class="size-4 text-ink-300 transition group-hover:translate-x-0.5 group-hover:text-brand-600" />
                  </a>
                </li>
              ))}
            </ul>
            <a href={bereich.uebersicht} class="link mt-4 inline-block text-sm">Alle Leistungen ansehen</a>
          </nav>
        )
      }
    </aside>
  </div>

  <CtaBand />
</BaseLayout>
