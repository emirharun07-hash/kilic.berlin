---
/** Vorlage für allgemeine Info-Seiten (src/content/seiten/*.md). */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { breadcrumbSchema } from '@/data/strukturierte-daten';
import { rubriken } from '@/data/rubriken';

interface Props {
  entry: CollectionEntry<'seiten'>;
}
const { entry } = Astro.props;
const d = entry.data;
const rubrik = rubriken[d.rubrik as keyof typeof rubriken] ?? rubriken.Patienteninformationen;
const crumbs = [
  { name: 'Startseite', href: '/' },
  ...(rubrik.href ? [{ name: rubrik.name, href: rubrik.href }] : []),
  { name: d.titel, href: `/${d.url}` },
];
---

<BaseLayout
  title={d.seo.title ?? d.titel}
  description={d.seo.description ?? d.einleitung ?? `${d.titel} – Informationen der Orthopädischen Praxis Mitte in Berlin.`}
  image={d.bild}
  noindex={d.seo.noindex}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero title={d.titel} eyebrow={rubrik.name} intro={d.einleitung} crumbs={crumbs} image={d.bild} imageAlt={d.bildAlt ?? ''} />
  <article class="container-page py-16 sm:py-20">
    <div class="prose-praxis mx-auto lg:mx-0">
      <slot />
    </div>
  </article>
  <CtaBand />
</BaseLayout>
