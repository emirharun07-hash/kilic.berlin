---
/**
 * Alle <head>-Angaben für Suchmaschinen und Social Media.
 * Wird ausschließlich vom BaseLayout eingebunden.
 */
import { praxis } from '@/data/praxis';
import { seoDefaults } from '@/data/seo';
import ogFallback from '@/assets/images/og-default.jpg';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
  /** Strukturierte Daten (JSON-LD), zusätzlich zu den globalen Praxisdaten */
  schema?: Record<string, unknown>[];
}

const { title, description, image, noindex = false, schema = [] } = Astro.props;

const fullTitle = title ? `${title} | ${seoDefaults.titelSuffix}` : seoDefaults.startseitenTitel;
const metaDescription = description ?? seoDefaults.beschreibung;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1'), Astro.site).href;
const og = await getImage({ src: image ?? ogFallback, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content={praxis.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
