---
/** Hinweis auf den digitalen Anamnesebogen (externer Anbieter, Link aus src/data/praxis.ts). */
import { praxis } from '@/data/praxis';
import Icon from '@/components/ui/Icon.astro';
---

<div class="flex flex-col gap-6 rounded-[var(--radius-card)] border border-brand-200 bg-brand-50 p-7 sm:flex-row sm:items-center sm:justify-between sm:p-8">
  <div class="flex gap-5">
    <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-white text-brand-600 shadow-[var(--shadow-soft)]">
      <Icon name="doc" class="size-6" />
    </span>
    <div>
      <p class="font-serif text-xl text-ink-900">Zum ersten Mal bei uns?</p>
      <p class="mt-2 max-w-xl text-[0.9375rem] leading-relaxed text-ink-700">
        Sind Sie das erste Mal bei uns oder seit mehr als einem Jahr nicht mehr da gewesen, dann füllen Sie bitte den
        Anamnesebogen digital aus.
      </p>
    </div>
  </div>
  <a href={praxis.anamnesebogen.url} target="_blank" rel="noopener noreferrer" class="btn-primary shrink-0">
    Anamnesebogen ausfüllen <Icon name="external" class="size-4" />
    <span class="sr-only">(externer Anbieter {praxis.anamnesebogen.anbieter}, neues Fenster)</span>
  </a>
</div>
