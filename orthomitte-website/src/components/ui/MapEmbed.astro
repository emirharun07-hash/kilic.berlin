---
/**
 * Datenschutzfreundliche Karte ("Zwei-Klick-Lösung"):
 * Die OpenStreetMap-Karte wird erst nach einem Klick geladen. Vorher werden
 * keinerlei Daten an Dritte übertragen. Zusätzlich direkte Links zu Routenplanern.
 */
import { praxis } from '@/data/praxis';
import Icon from './Icon.astro';
---

<div class="card relative overflow-hidden" data-map>
  <div class="relative aspect-[4/3] w-full bg-sand-200 sm:aspect-[16/10]" data-map-frame>
    <!-- Platzhalter: stilisierte Karte ohne externe Ressourcen -->
    <svg aria-hidden="true" class="absolute inset-0 size-full text-sand-300" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round">
        <path d="M-20 70 C 80 60, 160 90, 420 60" />
        <path d="M-20 170 C 100 160, 260 190, 420 150" />
        <path d="M120 -20 L 150 270" />
        <path d="M290 -20 L 260 270" />
      </g>
      <path d="M-20 120 C 60 100, 140 140, 220 115 S 360 95, 420 110" fill="none" stroke="#c9d9dc" stroke-width="18" />
    </svg>
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center">
      <span class="flex size-14 items-center justify-center rounded-full bg-brand-600 text-white shadow-lg">
        <Icon name="pin" class="size-7" />
      </span>
      <p class="max-w-sm text-sm text-ink-700">
        Mit Klick auf „Karte laden“ wird eine Karte von OpenStreetMap eingebunden. Dabei wird Ihre IP-Adresse an die
        OpenStreetMap Foundation übertragen. Weitere Informationen in unserer <a href="/datenschutz" class="link">Datenschutzerklärung</a>.
      </p>
      <button type="button" class="btn-secondary" data-map-load>Karte laden</button>
    </div>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-ink-100 px-5 py-4">
    <p class="text-sm text-ink-700">
      {praxis.adresse.strasse} ({praxis.adresse.zusatz}), {praxis.adresse.plz} {praxis.adresse.ort}
    </p>
    <div class="flex gap-4 text-sm">
      <a href={praxis.karten.google} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-1">
        Google Maps <Icon name="arrow-up-right" class="size-3.5" />
      </a>
      <a href={praxis.karten.apple} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-1">
        Apple Karten <Icon name="arrow-up-right" class="size-3.5" />
      </a>
    </div>
  </div>
</div>

<script define:vars={{ src: praxis.karten.osmEmbed }}>
  document.querySelectorAll('[data-map-load]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = btn.closest('[data-map]')?.querySelector('[data-map-frame]');
      if (!frame) return;
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'Karte: Lage der Praxis';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer';
      iframe.className = 'absolute inset-0 size-full border-0';
      frame.replaceChildren(iframe);
    });
  });
</script>
