---
/** Einheitliche Abschnittsüberschrift: kleine Dachzeile + große Serifenüberschrift + optionaler Text. */
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
  light?: boolean;
}
const { eyebrow, title, align = 'left', as: Tag = 'h2', id, light = false } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  {eyebrow && <p class:list={['eyebrow', align === 'center' && 'justify-center', light && '!text-brand-300']}>{eyebrow}</p>}
  <Tag
    id={id}
    class:list={[
      'mt-4 text-[2.125rem] leading-[1.1] sm:text-5xl',
      light && '!text-white',
    ]}
  >
    {title}
  </Tag>
  {
    Astro.slots.has('default') && (
      <div class:list={['mt-5 text-lg leading-relaxed', light ? 'text-ink-200' : 'text-ink-600']}>
        <slot />
      </div>
    )
  }
</div>
