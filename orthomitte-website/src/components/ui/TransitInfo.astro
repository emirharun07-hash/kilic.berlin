---
/** Liste der ÖPNV-Verbindungen (Daten: src/data/praxis.ts → verkehr). */
import { praxis } from '@/data/praxis';
import Icon from './Icon.astro';
---

<div class="card p-6">
  <h3 class="flex items-center gap-3 font-sans text-base font-semibold"><Icon name="train" class="size-5 text-brand-600" /> Öffentliche Verkehrsmittel</h3>
  <dl class="mt-4 grid gap-x-6 gap-y-2.5 text-sm sm:grid-cols-[auto_1fr]">
    {
      praxis.verkehr.map((v) => (
        <>
          <dt class="flex items-center gap-2 font-semibold text-ink-900">
            <span class="size-2.5 rounded-full" style={`background:${v.farbe}`} aria-hidden="true" />
            {v.art}
          </dt>
          <dd class="text-ink-600 max-sm:mb-2 max-sm:pl-4.5">{v.linien}</dd>
        </>
      ))
    }
  </dl>
</div>
