---
/**
 * Einheitlicher "Termin buchen"-Button.
 * Der Link kommt immer aus src/data/praxis.ts (terminbuchung.url) –
 * bei einem Wechsel des Buchungsanbieters muss nur diese eine Stelle geändert werden.
 */
import { praxis } from '@/data/praxis';
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost-light';
  label?: string;
  class?: string;
}
const { variant = 'primary', label = 'Termin online buchen', class: className = '' } = Astro.props;
const variantClass = { primary: 'btn-primary', secondary: 'btn-secondary', 'ghost-light': 'btn-ghost-light' }[variant];
---

<a
  href={praxis.terminbuchung.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[variantClass, className]}
  data-booking-link
>
  <Icon name="calendar" class="size-4.5" />
  <span>{label}</span>
  <span class="sr-only">(öffnet {praxis.terminbuchung.anbieter} in neuem Fenster)</span>
</a>
