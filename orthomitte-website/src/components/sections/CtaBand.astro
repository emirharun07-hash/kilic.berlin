---
/** Abschluss-Band "Termin vereinbaren" – wird am Ende fast jeder Seite eingesetzt. */
import { praxis } from '@/data/praxis';
import BookingButton from '@/components/ui/BookingButton.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Wir sind für Sie da.',
  text = 'Vereinbaren Sie Ihren Termin bequem online oder rufen Sie uns während der Sprechzeiten an.',
} = Astro.props;
---

<section class="container-page py-20 sm:py-24" aria-labelledby="cta-heading">
  <div class="relative overflow-hidden rounded-[2rem] bg-ink-900 px-6 py-14 sm:px-14 sm:py-16" data-reveal>
    <div aria-hidden="true" class="absolute -top-24 -right-24 size-80 rounded-full border-[28px] border-brand-500/15"></div>
    <div aria-hidden="true" class="absolute -top-6 -right-6 size-44 rounded-full border-[18px] border-brand-500/20"></div>
    <div class="relative grid grid-cols-1 items-center gap-10 lg:grid-cols-[1fr_auto]">
      <div class="max-w-2xl">
        <h2 id="cta-heading" class="text-3xl !text-white sm:text-[2.75rem] sm:leading-[1.1]">{title}</h2>
        <p class="mt-4 text-lg text-ink-200">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <BookingButton />
        <a href={`tel:${praxis.telefon.link}`} class="btn-ghost-light">
          <Icon name="phone" class="size-4.5" />
          {praxis.telefon.anzeige}
        </a>
      </div>
    </div>
  </div>
</section>
