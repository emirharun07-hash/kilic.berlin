---
/** Auf dem Smartphone stets sichtbare Leiste: Anrufen + Termin buchen. */
import { praxis } from '@/data/praxis';
import Icon from '@/components/ui/Icon.astro';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-100 bg-white/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur sm:hidden"
>
  <div class="grid grid-cols-[auto_1fr] gap-3">
    <a href={`tel:${praxis.telefon.link}`} class="btn-secondary !px-4" aria-label={`Praxis anrufen: ${praxis.telefon.anzeige}`}>
      <Icon name="phone" class="size-5" />
    </a>
    <a href={praxis.terminbuchung.url} target="_blank" rel="noopener noreferrer" class="btn-primary" data-booking-link>
      <Icon name="calendar" class="size-4.5" />
      Termin online buchen
    </a>
  </div>
</div>
